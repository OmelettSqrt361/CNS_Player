  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Tato aplikace byla vyvo\u0159ena za \xFA\u010Delem pozorov\xE1n\xED lidmy
    odehran\xFDch her v r\xE1cmi \u010Dlov\u011B\u010De nezlob se a jin\xFDch kruhov\xFDvh
    k\u0159\xED\u017Eov\xFDch her v r\xE1cmi tvorby st\u0159edo\u0161kolsk\xE9 odborn\xE9
    \u010Dinnosti.\nTato data jsou n\xE1sledn\u011B shroma\u017E\u010Fov\xE1na do
    po\u010D\xE1tku \xFAnora 2026, kdy jsou vyhodnocena oproti jednotliv\xFDm obt\xED\u017Enostem.\nTato
    aplikace ukl\xE1d\xE1 pouze data vytvo\u0159en\xE1 u\u017Eivatelem v r\xE1mci
